# ============================================================
# EATransform — AI Business Process Mapping Platform
# Environment configuration
#
# HOW TO USE (beginner friendly):
#   1. Copy this file and rename the copy to:  .env
#      (keep it in the same folder as this file — the project root)
#   2. Fill in the values below. Only AI_API_KEY is needed to
#      activate AI features. Everything else has safe defaults.
#   3. Restart the application (stop it and run `npm run dev` again).
#
# The application ALWAYS runs, even with no API key. Without a key
# the AI panel shows setup instructions and a built-in demo analyst
# ("mock" provider) can be used to try every feature offline.
# ============================================================

# ---- AI provider -------------------------------------------
# Which AI provider to use. Supported values:
#   gemini    - Google Gemini (recommended to start: has a free tier)
#   anthropic - Anthropic Claude
#   openai    - OpenAI GPT
#   mock      - Built-in offline demo analyst (no key needed)
AI_PROVIDER=gemini

# Your API key for the provider chosen above.
#   Gemini keys:    https://aistudio.google.com/apikey
#   Anthropic keys: https://console.anthropic.com/
#   OpenAI keys:    https://platform.openai.com/api-keys
AI_API_KEY=

# Optional: override the model used by the provider.
# Defaults: gemini-2.0-flash / claude-sonnet-5 / gpt-4o-mini
#AI_MODEL=

# Optional: request timeout in milliseconds (default 60000)
#AI_TIMEOUT_MS=60000

# Optional: how many times to retry a failed/invalid AI response (default 2)
#AI_MAX_RETRIES=2

# ---- Server ------------------------------------------------
# Port for the backend API (default 4000)
#PORT=4000

# Where the SQLite database file is stored (default ./data)
#DATA_DIR=./data
